-- ESP System
local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if Config.EspEnabled then
                if not Config.TeamEsp and plr.Team == LocalPlayer.Team then
                    if espStorage[plr] then espStorage[plr].Highlight.Enabled = false end
                else
                    if not espStorage[plr] then
                        local hl = Instance.new("Highlight")
                        hl.Name = "NaneskESP"
                        hl.FillColor = currentTheme.Accent
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                        espStorage[plr] = {Highlight = hl}
                    end
                    espStorage[plr].Highlight.Parent = plr.Character
                    espStorage[plr].Highlight.Enabled = true
                end
            else
                if espStorage[plr] then espStorage[plr].Highlight.Enabled = false end
            end
        end
    end
end

addToggleBtn(PlayersScroll, "👁️ Player ESP (X-Ray)", Config.EspEnabled, function(enabled)
    Config.EspEnabled = enabled
    updateESP()
end)

