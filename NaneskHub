local function createScriptCard(parent, item)
    local Card = I("Frame", parent, {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = currentTheme.Card, BackgroundTransparency = 0.2, ZIndex = 13})
    I("UICorner", Card, {CornerRadius = UDim.new(0, 6)})

