local function addToggleBtn(parent, txt, defaultState, callback)
    local state = defaultState or false
    local btn = I("TextButton", parent, {
        Size = UDim2.new(1, -6, 0, 28), BackgroundColor3 = state and currentTheme.Accent or currentTheme.Card, BackgroundTransparency = 0.2,
        Text = txt .. (state and " [ON]" or " [OFF]"), TextColor3 = currentTheme.Text, Font = Enum.Font.SourceSansBold, TextSize = 12, ZIndex = 13
    })
    I("UICorner", btn, {CornerRadius = UDim.new(0, 6)})
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = txt .. (state and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = state and currentTheme.Accent or currentTheme.Card
        callback(state)
    end)
    return btn
end

local function addSliderRow(parent, titleTxt, minVal, maxVal, defaultVal, callback)
    local frame = I("Frame", parent, {Size = UDim2.new(1, -6, 0, 32), BackgroundColor3 = currentTheme.Card, BackgroundTransparency = 0.2, ZIndex = 13})
    I("UICorner", frame, {CornerRadius = UDim.new(0, 6)})

    I("TextLabel", frame, {
        Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1,
        Text = titleTxt, TextColor3 = currentTheme.Text, Font = Enum.Font.SourceSansBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 14
    })

    local box = I("TextBox", frame, {
        Size = UDim2.new(0.3, 0, 0, 20), Position = UDim2.new(0.68, 0, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(10, 22, 40), Text = tostring(defaultVal), TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.SourceSansBold, TextSize = 11, ZIndex = 14
    })
    I("UICorner", box, {CornerRadius = UDim.new(0, 4)})

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            val = math.clamp(val, minVal, maxVal)
            box.Text = tostring(val)
            callback(val)
        end
    end)
end

