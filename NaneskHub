        Text = "[" .. (item.source or "API") .. "] " .. (item.title or "Unknown"), TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.SourceSansBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 14
    })

    local function makeBtn(pos, txt, clickFn)
        local b = I("TextButton", Card, {
            Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, pos, 0.5, -10),
            BackgroundColor3 = currentTheme.Accent, BackgroundTransparency = 0.1,
            Text = txt, TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.SourceSansBold, TextSize = 10, ZIndex = 14
        })
        I("UICorner", b, {CornerRadius = UDim.new(0, 4)})
        b.MouseButton1Click:Connect(clickFn)
    end

    makeBtn(-22, "▶", function()
        ShowScriptInfo(item)
        pcall(function()
            local fn = loadstring(item.code or item.script or "")
            if fn then task.spawn(fn) end
        end)
    end)
    makeBtn(-44, "📜", function() ShowScriptInfo(item) end)
    return Card
end

local function runLibrarySearch()
    local query = SearchBox.Text:lower()
    if query == "" then return end

    for _, child in ipairs(LibraryScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end

    local statusLabel = I("TextLabel", LibraryScroll, {
        Size = UDim2.new(2, 0, 0, 30), BackgroundTransparency = 1,
        Text = "⏳ Searching '" .. query .. "'...", TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.SourceSansBold, TextSize = 12, ZIndex = 13
    })

    task.spawn(function()
        local totalFound = 0
        if requestFunc then
            local url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query) .. "&max=24&page=1"
            local ok, response = pcall(function() return requestFunc({Url = url, Method = "GET"}) end)
            if ok and response and response.Body then
                local dataOk, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
                if dataOk and data and data.result then
                    local list = data.result.scripts or data.result.docs or {}
                    for _, scr in ipairs(list) do
                        if (scr.script or scr.code) and scr.title then
                            createScriptCard(LibraryScroll, {
                                title = scr.title, source = "ScriptBlox", code = scr.script or scr.code
                            })
                            totalFound = totalFound + 1
                        end
                    end
                end
            end
        end
        statusLabel:Destroy()
    end)
